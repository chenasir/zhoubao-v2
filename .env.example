# OpenRouter API Key —— 请自行填入，不要提交到 Git
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型：需与页面默认值保持一致，可按 OpenRouter 当前可用模型调整
LLM_MODEL=deepseek/deepseek-v4-pro

# OpenRouter Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 每次 LLM 调用超时秒数
LLM_TIMEOUT=90

# LLM 并发数（打分批次、生成 doc 时同时处理的请求数，建议 2-4）
LLM_CONCURRENCY=3

# 新闻抓取并发数。Vercel Hobby 建议 6-8，本地可按网络情况调整
FETCH_CONCURRENCY=8

# 可选：部署到公网时设置访问口令；留空则不启用鉴权
APP_ACCESS_TOKEN=change-this-to-a-long-random-string

# 服务监听端口
HOST=127.0.0.1
PORT=8765

# 抓取时对每个信源最多保留多少条候选
MAX_PER_SOURCE=30

# 全局过去几天
LOOKBACK_DAYS=7
