{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{static/**,templates/**,config/**}",
      "maxDuration": 300
    }
  },
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/api/index"
    }
  ]
}
